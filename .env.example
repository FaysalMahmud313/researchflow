# =============================================================================
# ResearchFlow Environment Configuration Template (.env.example)
# =============================================================================
# IMPORTANT:
# 1. Local development: start_local_pc.bat creates backend/.env for you. To do it by
#    hand, copy this file to backend/.env.
# 2. NEVER commit `.env` or any file containing real credentials to Git.
# 3. Production settings are generated on the server by deploy/server_setup.sh (see docs/DEPLOYMENT.md).
# =============================================================================

# Application Environment: development | testing | staging | production
APP_ENV=development
APP_NAME=ResearchFlow
APP_VERSION=1.0.0
DEBUG=false

# Origins & Network
FRONTEND_ORIGIN=http://localhost:5173
BACKEND_ORIGIN=http://localhost:8000
ALLOWED_HOSTS=localhost,127.0.0.1

# SQLite database file (created and migrated automatically at startup)
DATABASE_PATH=./tmp/researchflow.sqlite3

# Session & Cryptographic Signing Secrets
# Generate a strong secret using: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET_KEY=REPLACE_WITH_64_CHAR_RANDOM_SECRET_GENERATED_LOCALLY_DO_NOT_COMMIT
CSRF_SECRET_KEY=REPLACE_WITH_64_CHAR_RANDOM_CSRF_KEY_GENERATED_LOCALLY_DO_NOT_COMMIT
TOKEN_HASH_PEPPER=REPLACE_WITH_32_CHAR_RANDOM_PEPPER_FOR_TOKEN_HASHING

# Session Cookie & CSRF Policy
SESSION_COOKIE_NAME=rf_session
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_HTTPONLY=true
SESSION_COOKIE_SAMESITE=lax
SESSION_TTL_MINUTES=720
# "Keep me signed in" lifetime; other sign-ins end when the browser closes.
SESSION_REMEMBER_DAYS=30
CSRF_PROTECTION_ENABLED=true
CSRF_HEADER_NAME=X-CSRF-Token

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_AUTH_PER_MINUTE=10
RATE_LIMIT_API_PER_MINUTE=120
RATE_LIMIT_UPLOAD_PER_MINUTE=15

# Private File Storage (outside any web root)
STORAGE_BACKEND=local
PRIVATE_STORAGE_DIR=./private_uploads
MAX_UPLOAD_SIZE_BYTES=104857600
PROJECT_STORAGE_QUOTA_BYTES=2147483648
# Profile pictures are re-encoded to a small WebP; this caps the upload.
AVATAR_MAX_UPLOAD_BYTES=5242880

# Optional: only these email domains may sign up (comma-separated). Empty allows any.
ALLOWED_EMAIL_DOMAINS=

# Email for verification and password-reset codes: console | smtp
# console sends nothing (development returns the codes to the browser).
# smtp: port 587 uses STARTTLS, port 465 uses SSL.
EMAIL_BACKEND=console
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
EMAIL_FROM_ADDRESS=noreply@researchflow.local

# Optional DOI metadata lookup via Crossref (outbound network from the server)
DOI_LOOKUP_ENABLED=false

# Single-service hosting (see docs/DEPLOYMENT.md). Leave these out for local development.
# Folder with the built web app; when set, the API serves the web app too.
# FRONTEND_DIST_DIR=../frontend/dist
# WAL (default) or DELETE for hosts whose disks are network file systems.
# SQLITE_JOURNAL_MODE=WAL
# Only under backend/wsgi.py behind the host's own proxy: read the visitor's address from its headers.
# TRUST_PROXY_HEADERS=false

# Frontend Public Variables (SAFE PUBLIC VALUES ONLY — NEVER PUT SECRETS IN VITE_*)
# Leave VITE_API_BASE_URL unset in development: Vite proxies /api to the backend.
# VITE_API_BASE_URL=/api/v1
VITE_APP_ENV=development
